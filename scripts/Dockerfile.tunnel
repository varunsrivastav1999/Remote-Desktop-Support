FROM cloudflare/cloudflared:latest AS cloudflared-bin

FROM alpine:3.19
RUN apk add --no-cache ca-certificates libc6-compat
COPY --from=cloudflared-bin /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY scripts/tunnel_entrypoint.sh /tunnel_entrypoint.sh
RUN chmod +x /tunnel_entrypoint.sh

ENTRYPOINT ["/tunnel_entrypoint.sh"]
