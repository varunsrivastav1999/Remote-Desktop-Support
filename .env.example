# =================================================================
# AnyGravity — Environment Configuration
# =================================================================

# Server & Application
APP_NAME=AnyGravity
API_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000

# PostgreSQL
POSTGRES_USER=rsadmin
POSTGRES_PASSWORD=support_2026
POSTGRES_DB=remote_support
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rsadmin:support_2026@postgres:5432/remote_support

# Redis
REDIS_URL=redis://redis:6379/0

# Session & Presence TTL
SESSION_TTL_SECONDS=2592000

# CORS Allowed Origins (comma-separated or * for all)
CORS_ALLOWED_ORIGINS=*

# WebRTC STUN & TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_REALM=remote-support.local
TURN_USERNAME=remote
TURN_PASSWORD=support_2026
TURN_EXTERNAL_IP=127.0.0.1

# Optional: Cloudflare Named Tunnel Token for Permanent, Static Public URL
# Obtain from Cloudflare Zero Trust (Free): https://one.dash.cloudflare.com/
# If left blank, cloudflared automatically provisions a free Quick Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
